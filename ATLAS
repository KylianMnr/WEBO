    </div>

    {relDue.length>0&&<div className="alert-box danger" style={{cursor:'pointer',marginBottom:20}} onClick={()=>setView('crm')}>
      <span>⏰</span><div style={{flex:1}}><strong>{relDue.length} relance{relDue.length>1?'s':''} en retard</strong> — à traiter dans le CRM</div><span style={{color:'var(--t3)'}}>Voir →</span>
    </div>}

    <div className="kpi-grid">
      <div className="kpi"><div style={{fontSize:22,marginBottom:4}}>🎯</div><div className="kpi-val">{fmt(leads.length)}</div><div className="kpi-label">Prospects</div></div>
      <div className="kpi"><div style={{fontSize:22,marginBottom:4}}>✅</div><div className="kpi-val" style={{color:'var(--ok)'}}>{fmt(signed.length)}</div><div className="kpi-label">Signés</div></div>
      <div className="kpi"><div style={{fontSize:22,marginBottom:4}}>💶</div><div className="kpi-val" style={{color:'var(--ok)'}}>{fmt(caSigned)} €</div><div className="kpi-label">CA signé</div></div>
      <div className="kpi"><div style={{fontSize:22,marginBottom:4}}>📊</div><div className="kpi-val" style={{color:'var(--mk)'}}>{fmt(pipeline)} €</div><div className="kpi-label">Pipeline actif</div></div>
    </div>

    <div style={{display:'grid',gridTemplateColumns:'1fr 1fr',gap:20,marginBottom:24}}>
      <div className="card">
        <h3 style={{fontSize:15,fontWeight:600,marginBottom:16}}>Répartition du pipeline</h3>
        {topStatuses.length===0&&<p style={{color:'var(--t3)',fontSize:13}}>Aucun prospect pour l'instant.</p>}
        {topStatuses.map(([st,n])=>{const pct=leads.length?Math.round(n/leads.length*100):0;return(
          <div key={st} style={{marginBottom:12}}>
            <div style={{display:'flex',justifyContent:'space-between',fontSize:13,marginBottom:4}}><span>{STATUS_LBL[st]||st}</span><span style={{color:'var(--t3)'}}>{n}</span></div>
            <div style={{height:6,background:'var(--sf2)',borderRadius:4,overflow:'hidden'}}><div style={{width:pct+'%',height:'100%',background:'var(--ac)'}}></div></div>
          </div>);})}
      </div>
      <div className="card">
        <h3 style={{fontSize:15,fontWeight:600,marginBottom:16}}>Ce mois-ci</h3>
        <div style={{display:'flex',flexDirection:'column',gap:14}}>
          <div style={{display:'flex',justifyContent:'space-between',alignItems:'baseline'}}><span style={{color:'var(--t2)',fontSize:14}}>Nouveaux prospects</span><span style={{fontSize:24,fontWeight:800}}>{newThisMonth}</span></div>
