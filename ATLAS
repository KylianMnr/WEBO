function Finance({S}){
  const{crmLeads,expenses,addExpense,delExpense,setView,paidIds,togglePaid}=S;
  const leads=crmLeads||[];
  const num=v=>{const n=parseFloat(String(v==null?'':v).replace(/[^0-9.]/g,''));return isNaN(n)?0:n;};
  const fmt=n=>n.toLocaleString('fr-FR',{minimumFractionDigits:0,maximumFractionDigits:2});
  const exp=expenses||[];
  const paid=paidIds||[];
  // ── Entrées : deals signés du CRM ──
  const signed=leads.filter(l=>l.status==='reussi');
  const caTotal=signed.reduce((s,l)=>s+num(l.valeur),0);
  // Marge nette WEBO : 20% de la valeur, moins la part chasseur si apporté par un prospecteur (pas le fondateur)
  const margeNette=signed.reduce((s,l)=>{const v=num(l.valeur);const com=v*0.2;const parFondateur=(l.member_id||l.memberId)==='kylian'||!(l.member_id||l.memberId);return s+(parFondateur?com:com*0.5);},0);
  // Pipeline pondéré : somme (valeur × proba de l'étape) sur les deals actifs
  const PROBA={site_web:.35,identifier:.05,contact_std:.15,relance_std:.20,contact_siege:.25,relance_siege:.30,potentiel:.50,pas_potentiel:.05,rdv_call:.65,relance_rdv:.55,perdu:0,reussi:1};
  const pipelinePondere=leads.filter(l=>!['reussi','perdu','pas_potentiel'].includes(l.status)).reduce((s,l)=>s+num(l.valeur)*(PROBA[l.status]||0),0);
  // Objectif mensuel
  const OBJECTIF=15000;
  const nowD=new Date();const curKey=nowD.getFullYear()+'-'+String(nowD.getMonth()+1).padStart(2,'0');
  const caMois=signed.filter(l=>((l.date_created||l.dateCreated||'').slice(0,7))===curKey).reduce((s,l)=>s+num(l.valeur),0);
  const objPct=Math.min(100,Math.round(caMois/OBJECTIF*100));
  // encaissé = marqué payé dans Atlas OU payment_status='encaisse' côté CRM
  const isPaid=l=>paid.includes(l.id)||(l.payment_status||l.paymentStatus)==='encaisse';
  const encaisse=signed.filter(isPaid).reduce((s,l)=>s+num(l.valeur),0);
  const enAttente=caTotal-encaisse;
  // ── Sorties ──
  const depTotal=exp.reduce((s,e)=>s+num(e.amount),0);
  const solde=caTotal-depTotal;
  // ── Charges fixes mensuelles (récurrences ramenées au mois) ──
  const monthlyOf=e=>{const a=num(e.amount);const r=e.recurrence||'none';if(r==='mensuel')return a;if(r==='trimestriel')return a/3;if(r==='annuel')return a/12;return 0;};
  const chargesFixes=exp.reduce((s,e)=>s+monthlyOf(e),0);
  const recurrents=exp.filter(e=>(e.recurrence||'none')!=='none');
  // ── Dépenses par catégorie ──
  const byCat={};exp.forEach(e=>{byCat[e.category]=(byCat[e.category]||0)+num(e.amount);});
  const cats=Object.entries(byCat).sort((a,b)=>b[1]-a[1]);
  // ── Vue par mois (tendance solde) : 6 derniers mois ──
  const MONTHS=['jan','fév','mar','avr','mai','juin','juil','août','sep','oct','nov','déc'];
  const now=new Date();
  const months=[];
  for(let k=5;k>=0;k--){const d=new Date(now.getFullYear(),now.getMonth()-k,1);months.push({y:d.getFullYear(),m:d.getMonth()});}
  const monthKey=(y,m)=>y+'-'+String(m+1).padStart(2,'0');
  const trend=months.map(({y,m})=>{
    const key=monthKey(y,m);
    const inM=signed.filter(l=>{const c=(l.date_created||l.dateCreated||'').slice(0,7);return c===key;}).reduce((s,l)=>s+num(l.valeur),0);
    const outM=exp.filter(e=>(e.date||'').slice(0,7)===key).reduce((s,e)=>s+num(e.amount),0);
    return{label:MONTHS[m],in:inM,out:outM,net:inM-outM};
  });
  const maxAbs=Math.max(1,...trend.map(t=>Math.max(t.in,t.out)));

  return(<React.Fragment>
    <div style={{marginBottom:24,display:'flex',justifyContent:'space-between',alignItems:'flex-end',flexWrap:'wrap',gap:12}}>
      <div><h1 className="page-title">Finance</h1><p className="page-sub">Entrées · sorties · solde · charges fixes</p></div>
      <button className="btn btn-ghost btn-sm" onClick={()=>setView('crm')}>Ouvrir le CRM ↗</button>
    </div>

    <div className="kpi-grid" style={{marginBottom:16}}>
      <div className="kpi"><div style={{fontSize:22,marginBottom:4}}>💶</div><div className="kpi-val" style={{color:'var(--ok)'}}>{fmt(caTotal)} €</div><div className="kpi-label">CA signé</div></div>
      <div className="kpi"><div style={{fontSize:22,marginBottom:4}}>⏳</div><div className="kpi-val" style={{color:'var(--wn)'}}>{fmt(enAttente)} €</div><div className="kpi-label">À encaisser</div></div>
      <div className="kpi"><div style={{fontSize:22,marginBottom:4}}>📤</div><div className="kpi-val" style={{color:'var(--er)'}}>{fmt(depTotal)} €</div><div className="kpi-label">Dépenses</div></div>
      <div className="kpi"><div style={{fontSize:22,marginBottom:4}}>⚖️</div><div className="kpi-val" style={{color:solde>=0?'var(--ok)':'var(--er)'}}>{fmt(solde)} €</div><div className="kpi-label">Solde</div></div>
    </div>

    <div className="kpi-grid" style={{marginBottom:16}}>
      <div className="kpi"><div style={{fontSize:22,marginBottom:4}}>🏆</div><div className="kpi-val" style={{color:'var(--ac)'}}>{fmt(margeNette)} €</div><div className="kpi-label">Marge nette WEBO</div></div>
      <div className="kpi"><div style={{fontSize:22,marginBottom:4}}>📈</div><div className="kpi-val" style={{color:'var(--mk)'}}>{fmt(pipelinePondere)} €</div><div className="kpi-label">Pipeline pondéré</div></div>
      <div className="kpi"><div style={{fontSize:22,marginBottom:4}}>🎯</div><div className="kpi-val">{fmt(caMois)} €</div><div className="kpi-label">CA ce mois</div></div>
      <div className="kpi"><div style={{fontSize:22,marginBottom:4}}>{objPct>=100?'✅':'⏳'}</div><div className="kpi-val" style={{color:objPct>=100?'var(--ok)':'var(--wn)'}}>{objPct}%</div><div className="kpi-label">Objectif ({fmt(OBJECTIF)} €)</div></div>
    </div>

    <div className="card" style={{padding:16,marginBottom:24}}>
      <div style={{display:'flex',justifyContent:'space-between',fontSize:13,marginBottom:8}}><span style={{fontWeight:600}}>Objectif mensuel — {fmt(OBJECTIF)} €</span><span style={{color:'var(--t3)'}}>{fmt(caMois)} € / {objPct}%</span></div>
      <div style={{height:10,background:'var(--sf2)',borderRadius:6,overflow:'hidden'}}><div style={{width:objPct+'%',height:'100%',background:objPct>=100?'var(--ok)':'var(--ac)',transition:'width .3s'}}></div></div>
    </div>

    <div className="card" style={{padding:16,marginBottom:24,display:'flex',justifyContent:'space-between',alignItems:'center',flexWrap:'wrap',gap:12}}>
      <div><div style={{fontSize:13,color:'var(--t3)'}}>Charges fixes mensuelles (récurrences)</div><div style={{fontSize:26,fontWeight:800,color:'var(--er)'}}>{fmt(chargesFixes)} € <span style={{fontSize:14,fontWeight:400,color:'var(--t4)'}}>/ mois</span></div></div>
      <div style={{fontSize:12,color:'var(--t4)',textAlign:'right'}}>{recurrents.length} paiement{recurrents.length>1?'s':''} récurrent{recurrents.length>1?'s':''}<br/>soit {fmt(chargesFixes*12)} € / an</div>
    </div>

    <h3 style={{fontSize:15,fontWeight:600,marginBottom:12}}>Ajouter une dépense</h3>
    <ExpenseForm onAdd={addExpense}/>

    <div className="card" style={{marginBottom:24}}>
      <h3 style={{fontSize:15,fontWeight:600,marginBottom:16}}>Tendance sur 6 mois (entrées vs sorties)</h3>
      <div style={{display:'flex',alignItems:'flex-end',gap:16,height:160}}>
        {trend.map((t,i)=>(<div key={i} style={{flex:1,display:'flex',flexDirection:'column',alignItems:'center',gap:6}}>
          <div style={{flex:1,display:'flex',alignItems:'flex-end',gap:3,width:'100%',justifyContent:'center'}}>
            <div title={'Entrées : '+fmt(t.in)+' €'} style={{width:'42%',height:(t.in/maxAbs*120)+'px',background:'var(--ok)',borderRadius:'3px 3px 0 0',minHeight:t.in>0?4:0}}></div>
            <div title={'Sorties : '+fmt(t.out)+' €'} style={{width:'42%',height:(t.out/maxAbs*120)+'px',background:'var(--er)',borderRadius:'3px 3px 0 0',minHeight:t.out>0?4:0}}></div>
          </div>
          <div style={{fontSize:11,color:'var(--t4)'}}>{t.label}</div>
          <div style={{fontSize:11,fontWeight:600,color:t.net>=0?'var(--ok)':'var(--er)'}}>{t.net>=0?'+':''}{fmt(t.net)}</div>
        </div>))}
      </div>
      <div style={{display:'flex',gap:16,marginTop:12,fontSize:12,color:'var(--t3)'}}>
        <span style={{display:'flex',alignItems:'center',gap:6}}><span style={{width:10,height:10,background:'var(--ok)',borderRadius:2,display:'inline-block'}}></span>Entrées</span>
        <span style={{display:'flex',alignItems:'center',gap:6}}><span style={{width:10,height:10,background:'var(--er)',borderRadius:2,display:'inline-block'}}></span>Sorties</span>
      </div>
    </div>

    <div style={{display:'grid',gridTemplateColumns:'1fr 1fr',gap:20,marginBottom:24}}>
      <div className="card" style={{padding:0,overflow:'hidden'}}>
        <div style={{padding:'16px 20px',borderBottom:'1px solid var(--bd)'}}><h3 style={{fontSize:15,fontWeight:600}}>Dépenses récentes</h3></div>
        {exp.length===0&&<div style={{padding:24,textAlign:'center',color:'var(--t4)',fontSize:13}}>Aucune dépense enregistrée.</div>}
        {exp.slice(0,12).map(e=>(<div key={e.id} style={{display:'flex',justifyContent:'space-between',alignItems:'center',padding:'12px 20px',borderTop:'1px solid var(--bd)'}}>
          <div style={{minWidth:0}}><div style={{fontWeight:500,fontSize:14,display:'flex',alignItems:'center',gap:6}}>{e.label}{(e.recurrence&&e.recurrence!=='none')&&<span className="badge badge-mk" style={{fontSize:10}}>🔁 {e.recurrence}</span>}</div><div style={{fontSize:12,color:'var(--t4)'}}>{e.category} · {e.date}</div></div>
          <div style={{display:'flex',alignItems:'center',gap:10,flexShrink:0}}>
            <span style={{fontWeight:600,color:'var(--er)'}}>-{fmt(num(e.amount))} €</span>
            <button className="btn btn-ghost btn-sm" onClick={()=>{if(window.confirm('Supprimer cette dépense ?'))delExpense(e.id)}}>✕</button>
          </div>
        </div>))}
      </div>
      <div className="card">
        <h3 style={{fontSize:15,fontWeight:600,marginBottom:16}}>Dépenses par catégorie</h3>
        {cats.length===0&&<p style={{color:'var(--t3)',fontSize:13}}>Rien à afficher.</p>}
        {cats.map(([c,v])=>{const pct=depTotal?Math.round(v/depTotal*100):0;return(
          <div key={c} style={{marginBottom:12}}>
            <div style={{display:'flex',justifyContent:'space-between',fontSize:13,marginBottom:4}}><span>{c}</span><span style={{color:'var(--t3)'}}>{fmt(v)} €</span></div>
            <div style={{height:6,background:'var(--sf2)',borderRadius:4,overflow:'hidden'}}><div style={{width:pct+'%',height:'100%',background:'var(--er)'}}></div></div>
          </div>);})}
      </div>
    </div>

    <div className="card" style={{padding:0,overflow:'hidden'}}>
      <div style={{padding:'16px 20px',borderBottom:'1px solid var(--bd)',display:'flex',justifyContent:'space-between',alignItems:'center'}}>
        <h3 style={{fontSize:15,fontWeight:600}}>Deals signés — encaissement</h3>
        <span style={{fontSize:12,color:'var(--t3)'}}>{fmt(encaisse)} € encaissé · {fmt(enAttente)} € à encaisser</span>
      </div>
      {signed.length===0&&<div style={{padding:24,textAlign:'center',color:'var(--t4)',fontSize:13}}>Aucun deal signé pour l'instant.</div>}
      {signed.map(l=>{const done=isPaid(l);return(<div key={l.id} style={{display:'flex',justifyContent:'space-between',alignItems:'center',padding:'12px 20px',borderTop:'1px solid var(--bd)'}}>
        <div><div style={{fontWeight:500,fontSize:14}}>{l.nom}</div><div style={{fontSize:12,color:'var(--t4)'}}>{num(l.valeur)?fmt(num(l.valeur))+' €':'montant non renseigné'}</div></div>
        <button className={done?'btn btn-ghost btn-sm':'btn btn-p btn-sm'} onClick={()=>togglePaid(l.id)}>{done?'✓ Encaissé':'Marquer encaissé'}</button>
      </div>);})}
    </div>
  </React.Fragment>);
}

/* ═══ SHIELD ═══ */
function Shield({S}){
  const{resolved,resolveAlert}=S;
  const totR=SENTINEL.filter(a=>!resolved.includes(a.id)).reduce((s,a)=>{const v=parseFloat((a.risk||'0').replace(/[^0-9]/g,''));return s+(isNaN(v)?0:v)},0);
  return(<React.Fragment>
    <div style={{marginBottom:24}}><h1 className="page-title">Bouclier Légal</h1><p className="page-sub">Exposition restante : {totR.toLocaleString('fr-FR')} €</p></div>
    {SENTINEL.length===0&&<div className="card" style={{textAlign:'center',padding:40}}><div style={{fontSize:32,marginBottom:8}}>🛡️</div><p style={{color:'var(--t3)',marginBottom:4}}>Aucune alerte de conformité pour l'instant.</p><p style={{color:'var(--t4)',fontSize:13}}>Ce module se remplira quand tu auras des salariés et des obligations à suivre (DSN, OETH, RGAA…).</p></div>}
    {SENTINEL.map(a=>{const done=resolved.includes(a.id);return(
      <div key={a.id} className="card" style={{marginBottom:14,opacity:done?.35:1,borderColor:a.type==='critical'&&!done?'rgba(239,68,68,.12)':undefined,padding:20}}>
        <div style={{display:'flex',alignItems:'flex-start',gap:14}}>
          <span style={{fontSize:20,marginTop:2}}>{done?'✓':a.ic}</span>
          <div style={{flex:1}}>
            <div style={{display:'flex',alignItems:'center',gap:8,marginBottom:6}}><span style={{fontSize:15,fontWeight:600}}>{a.title}</span><span className={`badge ${a.type==='critical'?'badge-er':a.type==='warning'?'badge-wn':'badge-in'}`}>{done?'Résolu':a.type}</span></div>
            <p style={{fontSize:13,color:'var(--t2)',lineHeight:1.55,marginBottom:8}}>{a.desc}</p>
            <div style={{display:'flex',gap:16,fontSize:12,color:'var(--t4)'}}><span>Risque : <strong style={{color:'var(--er)'}}>{a.risk}</strong></span><span>Échéance : <strong>{a.dl}</strong></span></div>
          </div>
          {!done&&<button className="btn btn-p btn-sm" onClick={()=>resolveAlert(a.id)}>Traiter</button>}
        </div>
      </div>
    )})}
  </React.Fragment>);
}

