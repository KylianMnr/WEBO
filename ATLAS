<style>
/* ═══ DESIGN SYSTEM v3 — Enterprise Premium ═══ */
:root {
  --bg: #0B0E14; --sf1: #111520; --sf2: #171C28; --sf3: #1E2436; --sf4: #252C3D;
  --bd: rgba(255,255,255,.06); --bdh: rgba(255,255,255,.10);
  --t0: #fafafa; --t1: #e4e4e7; --t2: #a1a1aa; --t3: #71717a; --t4: #52525b;
  --ac: #C5A059; --ac2: #D4AF6A; --acg: rgba(197,160,89,.15); --acs: rgba(197,160,89,.08);
  --lx: #E74C4C; --lxs: rgba(231,76,76,.08); --lxb: rgba(231,76,76,.15);
  --tl: #089981; --tls: rgba(8,153,129,.08); --tlb: rgba(8,153,129,.15);
  --sy: #22d3ee; --sys: rgba(34,211,238,.08); --syb: rgba(34,211,238,.15);
  --mk: #8B5CF6; --mks: rgba(139,92,246,.08); --mkb: rgba(139,92,246,.15);
  --ok: #089981; --oks: rgba(8,153,129,.1); --wn: #C5A059; --wns: rgba(197,160,89,.1);
  --er: #E74C4C; --ers: rgba(231,76,76,.1); --in: #C5A059; --ins: rgba(197,160,89,.1);
  --r: 12px; --rl: 16px; --font: 'Inter',-apple-system,BlinkMacSystemFont,sans-serif;
  --mono: 'JetBrains Mono',ui-monospace,monospace;
  --shadow-sm: 0 1px 2px rgba(0,0,0,.3); --shadow: 0 2px 8px rgba(0,0,0,.25); --shadow-lg: 0 8px 32px rgba(0,0,0,.4);
  --topbar-h: 52px; --sidebar-w: 240px;
}
[data-theme="light"] {
  --bg: #F2EDDF; --sf1: #FFFDF8; --sf2: #FAF6EB; --sf3: #EDE5D0; --sf4: #E2D8BE;
  --bd: rgba(0,0,0,.08); --bdh: rgba(0,0,0,.14);
  --t0: #111113; --t1: #1f2937; --t2: #6b7280; --t3: #9ca3af; --t4: #b8ac90;
  --ac: #8B6A2E; --ac2: #A07A38; --acg: rgba(139,106,46,.12); --acs: rgba(139,106,46,.06);
  --lx: #C73838; --lxs: rgba(199,56,56,.06); --lxb: rgba(199,56,56,.12);
  --tl: #067961; --tls: rgba(6,121,97,.06); --tlb: rgba(6,121,97,.12);
  --sy: #0891b2; --sys: rgba(8,145,178,.06); --syb: rgba(8,145,178,.12);
  --mk: #7045D0; --mks: rgba(112,69,208,.06); --mkb: rgba(112,69,208,.12);
  --ok: #067961; --oks: rgba(6,121,97,.08); --wn: #8B6A2E; --wns: rgba(139,106,46,.08);
  --er: #C73838; --ers: rgba(199,56,56,.08); --in: #8B6A2E; --ins: rgba(139,106,46,.08);
  --shadow-sm: 0 1px 3px rgba(0,0,0,.06); --shadow: 0 2px 8px rgba(0,0,0,.08); --shadow-lg: 0 8px 32px rgba(0,0,0,.12);
}
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: var(--font); background: var(--bg); color: var(--t1); min-height: 100vh; font-size: 14px; line-height: 1.5; -webkit-font-smoothing: antialiased; transition: background .3s, color .3s; }
::-webkit-scrollbar { width: 6px; } ::-webkit-scrollbar-track { background: transparent; } ::-webkit-scrollbar-thumb { background: var(--sf4); border-radius: 3px; }

@keyframes fadeUp { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes slideIn { from { transform: translateX(100%); } to { transform: translateX(0); } }
@keyframes breathe { 0%,100% { opacity: .4; } 50% { opacity: 1; } }
@keyframes micPulse { 0% { box-shadow: 0 0 0 0 rgba(239,68,68,.35); } 70% { box-shadow: 0 0 0 10px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }

/* ═══ TOPBAR ═══ */
.topbar {
  position: fixed; top: 0; left: var(--sidebar-w); right: 0; height: var(--topbar-h);
  background: color-mix(in srgb, var(--bg) 85%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--bd); z-index: 90; display: flex; align-items: center;
  justify-content: space-between; padding: 0 28px; transition: background .3s;
}
.breadcrumb { font-size: 13px; color: var(--t3); display: flex; align-items: center; gap: 6px; }
.breadcrumb span { color: var(--t1); font-weight: 600; }
.search-bar {
  display: flex; align-items: center; gap: 8px; padding: 7px 14px;
  background: var(--sf2); border: 1px solid var(--bd); border-radius: 8px;
  color: var(--t3); font-size: 13px; cursor: pointer; transition: border-color .2s; min-width: 240px;
}
.search-bar:hover { border-color: var(--bdh); }
.search-bar kbd { background: var(--sf3); padding: 1px 6px; border-radius: 4px; font-size: 11px; font-family: var(--font); color: var(--t4); }
.topbar-right { display: flex; align-items: center; gap: 16px; }
.notif-btn {
  width: 36px; height: 36px; border-radius: 8px; border: 1px solid var(--bd); background: var(--sf2);
  display: flex; align-items: center; justify-content: center; cursor: pointer; position: relative; transition: all .15s; font-size: 16px;
}
.notif-btn:hover { border-color: var(--bdh); background: var(--sf3); }
.notif-dot { position: absolute; top: 6px; right: 6px; width: 7px; height: 7px; border-radius: 50%; background: var(--er); border: 2px solid var(--bg); }
.theme-btn {
  width: 36px; height: 36px; border-radius: 8px; border: 1px solid var(--bd); background: var(--sf2);
  display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all .15s; font-size: 16px;
}
.theme-btn:hover { border-color: var(--bdh); background: var(--sf3); }
.avatar {
  width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(135deg, var(--ac), #7c3aed);
  display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; color: #fff; cursor: pointer;
}

/* ═══ SIDEBAR ═══ */
.sidebar {
  width: var(--sidebar-w); min-height: 100vh; background: var(--sf1); border-right: 1px solid var(--bd);
  position: fixed; left: 0; top: 0; z-index: 100; display: flex; flex-direction: column; transition: background .3s;
}
.main { margin-left: var(--sidebar-w); padding-top: var(--topbar-h); }
.main-inner { padding: 28px 32px; max-width: 1280px; animation: fadeUp .35s ease; }

@media (max-width: 900px) { .sidebar { display: none; } .main { margin-left: 0; } .topbar { left: 0; } }

.nav-list { display: flex; flex-direction: column; flex: 1; }
.nav-item {
  display: flex; align-items: center; gap: 12px; padding: 14px 20px;
  font-size: 14px; font-weight: 500; color: var(--t3); cursor: pointer;
  transition: all .15s; border-left: 2px solid transparent; flex: 1;
}
.nav-item:hover { color: var(--t1); background: var(--acs); }
.nav-item.active { color: var(--ac2); background: var(--acs); border-left-color: var(--ac); font-weight: 600; }
.nav-section { padding: 20px 20px 8px; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .8px; color: var(--t4); }
.nav-icon { font-size: 18px; width: 24px; text-align: center; opacity: .85; }

/* ═══ COMPONENTS ═══ */
.btn {
  padding: 9px 18px; border: none; border-radius: 8px; font-weight: 600; font-size: 13px;
  font-family: var(--font); cursor: pointer; transition: all .15s; display: inline-flex;
  align-items: center; gap: 6px; white-space: nowrap;
}
.btn:hover { transform: translateY(-1px); } .btn:active { transform: translateY(0); }
.btn-p { background: var(--ac); color: #fff; box-shadow: 0 1px 3px var(--acg); }
.btn-p:hover { background: #5558e6; }
.btn-ok { background: var(--ok); color: #fff; } .btn-ok:hover { background: #16a34a; }
.btn-er { background: var(--er); color: #fff; } .btn-er:hover { background: #dc2626; }
.btn-ghost { background: transparent; color: var(--t2); border: 1px solid var(--bd); }
.btn-ghost:hover { background: var(--sf2); border-color: var(--bdh); color: var(--t1); }
.btn-sm { padding: 6px 12px; font-size: 12px; border-radius: 6px; }
.btn:disabled { opacity: .3; cursor: not-allowed; transform: none !important; }

.badge {
  padding: 3px 10px; border-radius: 6px; font-size: 11px; font-weight: 600;
  display: inline-flex; align-items: center; gap: 4px;
}
.badge-ok { background: var(--oks); color: var(--ok); } .badge-wn { background: var(--wns); color: var(--wn); }
.badge-er { background: var(--ers); color: var(--er); } .badge-in { background: var(--ins); color: var(--in); }
.badge-mk { background: var(--mks); color: var(--mk); }

.card {
  background: var(--sf1); border: 1px solid var(--bd); border-radius: var(--rl);
  padding: 24px; transition: all .25s; box-shadow: var(--shadow-sm);
}
.card:hover { border-color: var(--bdh); box-shadow: var(--shadow); }

.input {
  width: 100%; padding: 10px 14px; border: 1px solid var(--bd); border-radius: 8px;
  background: var(--sf2); color: var(--t1); font-size: 14px; font-family: var(--font);
  outline: none; transition: all .2s;
}
.input:focus { border-color: var(--ac); box-shadow: 0 0 0 3px var(--acg); }
.label { display: block; font-size: 13px; font-weight: 500; color: var(--t2); margin-bottom: 6px; }
.field { margin-bottom: 16px; }

.kpi-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 16px; margin-bottom: 24px; }
.kpi {
  background: var(--sf1); border: 1px solid var(--bd); border-radius: var(--rl);
  padding: 24px; text-align: center; transition: all .25s; box-shadow: var(--shadow-sm);
}
.kpi:hover { border-color: var(--bdh); transform: translateY(-2px); box-shadow: var(--shadow); }
.kpi-val { font-size: 28px; font-weight: 800; margin: 8px 0 4px; letter-spacing: -.5px; }
.kpi-label { font-size: 12px; color: var(--t3); font-weight: 500; }

table.data { width: 100%; border-collapse: collapse; }
table.data th {
  text-align: left; padding: 14px 16px; font-size: 11px; font-weight: 600;
  text-transform: uppercase; letter-spacing: .5px; color: var(--t4); border-bottom: 1px solid var(--bd);
}
table.data td { padding: 14px 16px; border-bottom: 1px solid var(--bd); font-size: 13px; }
table.data tbody tr { transition: background .15s; }
table.data tbody tr:hover { background: var(--acs); }
table.data tbody tr:last-child td { border-bottom: none; }

/* ═══ CHAT (Slack-style) ═══ */
.chat-frame { display: flex; flex-direction: column; height: 520px; border-radius: var(--rl); overflow: hidden; border: 1px solid var(--bd); background: var(--bg); }
.chat-header { padding: 16px 20px; background: var(--sf1); border-bottom: 1px solid var(--bd); display: flex; align-items: center; gap: 12px; }
.chat-body { flex: 1; overflow-y: auto; padding: 20px; }
.chat-input-bar { padding: 16px; background: var(--sf1); border-top: 1px solid var(--bd); display: flex; gap: 8px; align-items: center; }

.msg-row { display: flex; gap: 12px; margin-bottom: 16px; animation: fadeUp .25s ease; }
.msg-row.user { justify-content: flex-end; }
.msg-avatar { width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 14px; flex-shrink: 0; }
.msg-content { max-width: 80%; }
.msg-name { font-size: 12px; font-weight: 600; margin-bottom: 4px; }
.msg-bubble {
  padding: 12px 16px; border-radius: 12px; font-size: 13.5px; line-height: 1.55;
  background: var(--sf2); border: 1px solid var(--bd); color: var(--t1);
}
.msg-row.user .msg-bubble { background: var(--ac); border-color: var(--ac); color: #fff; border-radius: 12px 12px 4px 12px; }

/* ═══ TERMINAL ═══ */
.terminal {
  background: var(--bg); border: 1px solid var(--bd); border-radius: var(--r);
  padding: 16px; font-family: var(--mono); font-size: 11.5px; line-height: 1.6;
  max-height: 200px; overflow-y: auto; transition: background .3s;
}

/* ═══ KANBAN ═══ */
.kan-cols { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
.kan-col { background: var(--sf1); border: 1px solid var(--bd); border-radius: var(--rl); padding: 16px; min-height: 240px; }
.kan-col-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; padding-bottom: 12px; border-bottom: 1px solid var(--bd); }
.kan-card {
  background: var(--sf2); border: 1px solid var(--bd); border-radius: var(--r);
  padding: 14px; margin-bottom: 10px; cursor: grab; transition: all .15s;
}
.kan-card:hover { border-color: var(--bdh); box-shadow: var(--shadow); transform: translateY(-1px); }

/* ═══ CALENDAR ═══ */
.cal-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 4px; }
.cal-head { padding: 8px; text-align: center; font-size: 11px; font-weight: 600; color: var(--t4); }
.cal-day {
  padding: 8px; min-height: 72px; min-width: 0; background: var(--sf1); border: 1px solid var(--bd);
  border-radius: 8px; font-size: 12px; transition: all .12s; overflow: hidden;
}
.cal-day:hover { border-color: var(--bdh); } .cal-day.today { border-color: var(--ac); background: var(--acs); }
.cal-day.empty { opacity: .15; background: transparent; border-color: transparent; }
.cal-ev {
  padding: 2px 6px; border-radius: 4px; font-size: 10px; font-weight: 600; max-width: 100%;
  margin-top: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block;
}
.cal-ev.formation { background: var(--oks); color: var(--ok); }
.cal-ev.legal { background: var(--ers); color: var(--er); }
.cal-ev.meeting { background: var(--ins); color: var(--in); }
.cal-ev.conge { background: var(--mks); color: var(--mk); }

/* ═══ MISC ═══ */
.overlay { position: fixed; inset: 0; background: rgba(0,0,0,.65); z-index: 999; display: flex; align-items: center; justify-content: center; animation: fadeIn .15s; }
.modal { background: var(--sf1); border: 1px solid var(--bdh); border-radius: var(--rl); padding: 32px; max-width: 520px; width: 94%; max-height: 85vh; overflow-y: auto; animation: fadeUp .25s ease; box-shadow: var(--shadow-lg); }
.artifact-panel {
  position: fixed; top: 0; right: 0; width: 520px; max-width: 92vw; height: 100vh;
  background: var(--sf1); border-left: 1px solid var(--bd); z-index: 1000;
  display: flex; flex-direction: column; box-shadow: -4px 0 24px rgba(0,0,0,.4); animation: slideIn .25s ease;
}
.alert-box { padding: 14px 18px; border-radius: var(--r); font-size: 13px; display: flex; align-items: flex-start; gap: 10px; margin-bottom: 12px; }
.alert-box.danger { background: var(--ers); border: 1px solid rgba(239,68,68,.15); color: var(--er); }
.alert-box.warn { background: var(--wns); border: 1px solid rgba(234,179,8,.15); color: var(--wn); }
.alert-box.success { background: var(--oks); border: 1px solid rgba(34,197,94,.15); color: var(--ok); }
.alert-box.purple { background: var(--mks); border: 1px solid rgba(167,139,250,.15); color: var(--mk); }
.progress { height: 4px; background: var(--sf3); border-radius: 2px; overflow: hidden; }
.progress-fill { height: 100%; border-radius: 2px; transition: width .5s ease; }
.mic-btn {
  width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--bd); background: var(--sf2);
  color: var(--t3); font-size: 15px; cursor: pointer; display: flex; align-items: center; justify-content: center;
  transition: all .15s; flex-shrink: 0;
}
.mic-btn:hover { border-color: var(--er); color: var(--er); background: var(--ers); }
.mic-btn.on { border-color: var(--er); color: var(--er); background: var(--ers); animation: micPulse 1.2s infinite; }
.range-input { -webkit-appearance: none; width: 100%; height: 6px; border-radius: 3px; background: var(--sf3); outline: none; cursor: pointer; }
.range-input::-webkit-slider-thumb { -webkit-appearance: none; width: 18px; height: 18px; border-radius: 50%; background: var(--ac); cursor: pointer; border: 2px solid var(--sf1); box-shadow: 0 1px 4px var(--acg); }
.role-switch { display: flex; background: var(--sf2); border-radius: 8px; padding: 3px; border: 1px solid var(--bd); gap: 2px; }
.role-opt { padding: 6px 12px; border: none; border-radius: 6px; font-size: 11px; font-weight: 600; font-family: var(--font); cursor: pointer; transition: all .15s; background: transparent; color: var(--t3); }
.role-opt.active { background: var(--ac); color: #fff; }
.drop-zone {
  border: 1px dashed var(--sf4); border-radius: var(--rl); padding: 32px; text-align: center;
  cursor: pointer; transition: all .2s; background: transparent;
}
.drop-zone:hover { border-color: var(--ac); background: var(--acs); }
.status-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
.status-dot.green { background: var(--ok); animation: breathe 2s infinite; }
h1.page-title { font-size: 24px; font-weight: 700; letter-spacing: -.3px; color: var(--t0); }
.page-sub { font-size: 14px; color: var(--t3); margin-top: 2px; }
.section-gap { margin-bottom: 24px; }
</style>
