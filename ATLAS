/* ═══ RECHERCHE GLOBALE (champ isolé, sans perte de focus) ═══ */
function SearchBox({leads,cands,vault,events,go}){
  const[q,setQ]=useState('');
  const[open,setOpen]=useState(false);
  const boxRef=useRef(null);
  useEffect(()=>{
    const onClick=e=>{if(boxRef.current&&!boxRef.current.contains(e.target))setOpen(false);};
    document.addEventListener('mousedown',onClick);
    return()=>document.removeEventListener('mousedown',onClick);
  },[]);
  const ql=q.trim().toLowerCase();
  let results=[];
  if(ql.length>=2){
    (leads||[]).forEach(l=>{if((l.nom||'').toLowerCase().includes(ql))results.push({type:'Prospect',label:l.nom,sub:l.status||'',view:'crm'});});
    (cands||[]).forEach(c=>{if((c.name||'').toLowerCase().includes(ql)||(c.role||'').toLowerCase().includes(ql))results.push({type:'Candidat',label:c.name,sub:c.role||'',view:'ats'});});
    (vault||[]).forEach(d=>{if((d.title||'').toLowerCase().includes(ql)||(d.category||'').toLowerCase().includes(ql))results.push({type:'Document',label:d.title,sub:d.category||'',view:'coffre'});});
    (events||[]).forEach(ev=>{if((ev.title||'').toLowerCase().includes(ql))results.push({type:'Agenda',label:ev.title,sub:ev.date||'',view:'calendar'});});
    results=results.slice(0,12);
  }
  const pick=r=>{setOpen(false);setQ('');if(r.view==='crm'){window.open('https://kylianmnr.github.io/WEBO/','_blank','noopener,noreferrer');}else go(r.view);};
  return(<div ref={boxRef} style={{position:'relative',minWidth:280}}>
    <div className="search-bar" style={{cursor:'text'}}>
      <span style={{opacity:.5}}>🔍</span>
      <input value={q} onChange={e=>{setQ(e.target.value);setOpen(true);}} onFocus={()=>setOpen(true)} placeholder="Rechercher un prospect, candidat, document…" style={{border:'none',background:'transparent',outline:'none',color:'var(--t1)',fontSize:13,flex:1,fontFamily:'var(--font)'}}/>
    </div>
    {open&&ql.length>=2&&<div className="card" style={{position:'absolute',top:'calc(100% + 6px)',left:0,right:0,zIndex:50,maxHeight:360,overflow:'auto',padding:6}}>
      {results.length===0&&<div style={{padding:'10px 12px',color:'var(--t4)',fontSize:13}}>Aucun résultat</div>}
      {results.map((r,i)=>(<div key={i} onClick={()=>pick(r)} style={{padding:'8px 12px',borderRadius:8,cursor:'pointer',display:'flex',justifyContent:'space-between',alignItems:'center',gap:8}} onMouseEnter={e=>e.currentTarget.style.background='var(--sf2)'} onMouseLeave={e=>e.currentTarget.style.background='transparent'}>
        <div style={{minWidth:0}}><div style={{fontSize:13,fontWeight:500,whiteSpace:'nowrap',overflow:'hidden',textOverflow:'ellipsis'}}>{r.label}</div>{r.sub&&<div style={{fontSize:11,color:'var(--t4)'}}>{r.sub}</div>}</div>
        <span className="badge badge-in" style={{fontSize:10,flexShrink:0}}>{r.type}</span>
      </div>))}
    </div>}
  </div>);
}

