/* ═══ REPORTS ═══ */
function Reports(){
  const[gen,setGen]=useState(null);
  const reps=[{id:'c',ic:'🛡️',t:'Conformité 360°'},{id:'r',ic:'♿',t:'RGAA / EAA'},{id:'o',ic:'📦',t:'Offboarding'},{id:'t',ic:'📉',t:'Turnover'},{id:'k',ic:'🔗',t:'Logs CRM'}];
  const dl=r=>{setGen(r.id);setTimeout(()=>{setGen(null);confetti({particleCount:40,spread:40});alert('Téléchargé : '+r.t)},1200)};
  return(<React.Fragment>
    <div style={{marginBottom:24}}><h1 className="page-title">Rapports</h1><p className="page-sub">Exports automatisés</p></div>
    <div style={{display:'grid',gridTemplateColumns:'repeat(auto-fill,minmax(240px,1fr))',gap:16}}>
      {reps.map(r=>(<div key={r.id} className="card" style={{textAlign:'center',padding:28}}>
        <div style={{fontSize:28,marginBottom:10}}>{r.ic}</div>
        <div style={{fontWeight:600,marginBottom:14}}>{r.t}</div>
        <button className={`btn ${gen===r.id?'btn-ghost':'btn-p'}`} style={{width:'100%',justifyContent:'center'}} onClick={()=>dl(r)} disabled={gen!==null}>{gen===r.id?'Génération…':'Télécharger'}</button>
      </div>))}
    </div>
  </React.Fragment>);
}

ReactDOM.createRoot(document.getElementById('root')).render(<App/>);
</script>
