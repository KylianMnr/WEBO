        const cc=await sb.from("chat_channels").select("*");
        if(alive&&!cc.error)setChatChannels(cc.data||[]);
        const cm=await sb.from("chat_messages").select("*").order("created_at",{ascending:false}).limit(300);
        if(alive&&!cm.error)setChatMessages((cm.data||[]).slice().reverse());
      }catch(e){}
      if(alive)setSbReady(true);
    })();
    const ch=sb.channel("atlas_rt")
      .on("postgres_changes",{event:"*",schema:"public",table:"agenda_events"},p=>{
        if(p.eventType==="INSERT")setCalEv(pr=>pr.some(x=>x.id===p.new.id)?pr:[...pr,p.new]);
        if(p.eventType==="UPDATE")setCalEv(pr=>pr.map(x=>x.id===p.new.id?p.new:x));
        if(p.eventType==="DELETE")setCalEv(pr=>pr.filter(x=>x.id!==p.old.id));
      })
      .on("postgres_changes",{event:"*",schema:"public",table:"ats_candidates"},p=>{
        if(p.eventType==="INSERT")setCands(pr=>pr.some(x=>x.id===p.new.id)?pr:[p.new,...pr]);
        if(p.eventType==="UPDATE")setCands(pr=>pr.map(x=>x.id===p.new.id?p.new:x));
        if(p.eventType==="DELETE")setCands(pr=>pr.filter(x=>x.id!==p.old.id));
      })
      .on("postgres_changes",{event:"*",schema:"public",table:"leads"},p=>{
        if(p.eventType==="INSERT")setCrmLeads(pr=>pr.some(x=>x.id===p.new.id)?pr:[...pr,p.new]);
        if(p.eventType==="UPDATE")setCrmLeads(pr=>pr.map(x=>x.id===p.new.id?p.new:x));
        if(p.eventType==="DELETE")setCrmLeads(pr=>pr.filter(x=>x.id!==p.old.id));
      })
      .on("postgres_changes",{event:"*",schema:"public",table:"vault_docs"},p=>{
        if(p.eventType==="INSERT")setVault(pr=>pr.some(x=>x.id===p.new.id)?pr:[p.new,...pr]);
        if(p.eventType==="UPDATE")setVault(pr=>pr.map(x=>x.id===p.new.id?p.new:x));
        if(p.eventType==="DELETE")setVault(pr=>pr.filter(x=>x.id!==p.old.id));
      })
      .on("postgres_changes",{event:"*",schema:"public",table:"finance_expenses"},p=>{
        if(p.eventType==="INSERT")setExpenses(pr=>pr.some(x=>x.id===p.new.id)?pr:[p.new,...pr]);
        if(p.eventType==="UPDATE")setExpenses(pr=>pr.map(x=>x.id===p.new.id?p.new:x));
        if(p.eventType==="DELETE")setExpenses(pr=>pr.filter(x=>x.id!==p.old.id));
      })
      .on("postgres_changes",{event:"*",schema:"public",table:"finance_paid"},p=>{
        if(p.eventType==="DELETE")setPaidIds(pr=>pr.filter(id=>id!==p.old.lead_id));
        else{const r=p.new;setPaidIds(pr=>{const has=pr.includes(r.lead_id);if(r.paid&&!has)return[...pr,r.lead_id];if(!r.paid&&has)return pr.filter(id=>id!==r.lead_id);return pr;});}
      })
      .on("postgres_changes",{event:"*",schema:"public",table:"chat_channels"},p=>{
        if(p.eventType==="INSERT")setChatChannels(pr=>pr.some(x=>x.id===p.new.id)?pr:[...pr,p.new]);
        if(p.eventType==="UPDATE")setChatChannels(pr=>pr.map(x=>x.id===p.new.id?p.new:x));
        if(p.eventType==="DELETE")setChatChannels(pr=>pr.filter(x=>x.id!==p.old.id));
      })
      .on("postgres_changes",{event:"*",schema:"public",table:"chat_messages"},p=>{
        if(p.eventType==="INSERT")setChatMessages(pr=>pr.some(x=>x.id===p.new.id)?pr:[...pr,p.new]);
        if(p.eventType==="DELETE")setChatMessages(pr=>pr.filter(x=>x.id!==p.old.id));
      })
      .subscribe();
    return()=>{alive=false;sb.removeChannel(ch);};
  },[authed]);

  const addEmp=e=>{setEmps(p=>[...p,{...e,id:uid(),score:70,risk:'low',cpf:1500,conges:25}])};
  const addLeave=l=>{setLeaves(p=>[...p,{...l,id:uid(),status:'pending',date:now()}])};
  const approveLeave=(id,ok)=>{setLeaves(p=>p.map(l=>{if(l.id!==id)return l;if(ok){const emp=emps.find(e=>e.name===l.empName);if(emp){const days=Math.max(1,Math.ceil((new Date(l.end)-new Date(l.start))/86400000));setEmps(prev=>prev.map(e=>e.id===emp.id?{...e,conges:Math.max(0,e.conges-days)}:e));setCalEv(prev=>[...prev,{id:uid(),day:new Date(l.start).getDate()||15,title:`Congé ${l.empName.split(' ')[0]}`,type:'conge',emp:l.empName}])}}return{...l,status:ok?'approved':'refused'}}))};
  const saveToVault=doc=>{setVault(p=>[{...doc,id:uid(),savedAt:now()},...p])};
  const addVaultDoc=async doc=>{const row={id:uid(),title:doc.title,url:doc.url||'',category:doc.category||'Général',note:doc.note||'',created_at:new Date().toISOString()};setVault(p=>p.some(x=>x.id===row.id)?p:[row,...p]);if(sb){try{await sb.from("vault_docs").insert(row)}catch(e){}}};
  const delVaultDoc=async id=>{setVault(p=>p.filter(x=>x.id!==id));if(sb){try{await sb.from("vault_docs").delete().eq("id",id)}catch(e){}}};
  const addExpense=async ex=>{const row={id:uid(),label:ex.label,amount:Number(ex.amount)||0,category:ex.category||'Divers',date:ex.date||todayISO(),recurrence:ex.recurrence||'none',created_at:new Date().toISOString()};setExpenses(p=>p.some(x=>x.id===row.id)?p:[row,...p]);if(sb){try{await sb.from("finance_expenses").insert(row)}catch(e){}}};
  const delExpense=async id=>{setExpenses(p=>p.filter(x=>x.id!==id));if(sb){try{await sb.from("finance_expenses").delete().eq("id",id)}catch(e){}}};
  const togglePaid=async(leadId)=>{const isPaid=paidIds.includes(leadId);if(isPaid){setPaidIds(p=>p.filter(id=>id!==leadId));if(sb){try{await sb.from("finance_paid").delete().eq("lead_id",leadId)}catch(e){}}}else{setPaidIds(p=>p.includes(leadId)?p:[...p,leadId]);if(sb){try{await sb.from("finance_paid").upsert({lead_id:leadId,paid:true,updated_at:new Date().toISOString()})}catch(e){}}}};
  const sendChat=async(channelId,txt)=>{if(!txt.trim())return;const msg={id:uid(),channel_id:channelId,sender_id:myId,text:txt,created_at:new Date().toISOString(),lead_id:"",attachment_url:"",attachment_name:"",attachment_type:""};setChatMessages(p=>[...p,msg]);const lm=new Date().toISOString();const ch=chatChannels.find(c=>c.id===channelId);const reads={...((ch&&ch.reads)||{}),[myId]:lm};setChatChannels(p=>p.map(c=>c.id===channelId?{...c,last_msg_at:lm,reads}:c));if(sb){try{await sb.from("chat_messages").insert(msg);await sb.from("chat_channels").update({last_msg_at:lm,reads}).eq("id",channelId)}catch(e){}}};
  const openArt=key=>{if(ARTS_DB[key]){setArt(ARTS_DB[key]);saveToVault({title:ARTS_DB[key].title,content:ARTS_DB[key].content,type:key})}};
  const addCandidate=async c=>{const row={id:uid(),name:c.name,role:c.role||'',match:c.match||Math.floor(70+Math.random()*25),col:'sourced',src:c.src||'Manuel',created_at:new Date().toISOString()};setCands(p=>p.some(x=>x.id===row.id)?p:[row,...p]);if(sb){try{await sb.from("ats_candidates").insert(row)}catch(e){}}};
  const moveCandidate=async(id,col)=>{setCands(p=>p.map(c=>c.id===id?{...c,col}:c));if(sb){try{await sb.from("ats_candidates").update({col}).eq("id",id)}catch(e){}}};
  const resolveAlert=id=>{setResolved(p=>[...p,id]);confetti({particleCount:40,spread:45})};
  const addCalEvent=async ev=>{const date=ev.date||todayISO();const row={id:uid(),date,title:ev.title||'Sans titre',time:ev.time||'09:00',end_time:ev.end_time||'',all_day:!!ev.all_day,color:ev.color||'var(--purple)',assignee_ids:[],owner_id:'atlas',created_at:new Date().toISOString()};setCalEv(p=>p.some(x=>x.id===row.id)?p:[...p,row]);if(sb){try{await sb.from("agenda_events").insert(row)}catch(e){}}};
  const switchRole=r=>{setRole(r);setView(r==='salarie'?'portal':'dashboard')};
  const crit=SENTINEL.filter(x=>x.type==='critical'&&!resolved.includes(x.id)).length;

  const navAdmin=[{id:'dashboard',ic:'📊',lb:'Dashboard'},{id:'messages',ic:'✉️',lb:'Messagerie'},{id:'warroom',ic:'💬',lb:'War Room'},...(isFondateur?[{id:'finance',ic:'💶',lb:'Finance'}]:[]),{id:'calendar',ic:'📅',lb:'Agenda'},{id:'ats',ic:'🎯',lb:'Recrutement'},{id:'coffre',ic:'🔒',lb:'Coffre-Fort'},{id:'crm',ic:'🔗',lb:'Hub CRM'},{id:'reports',ic:'📥',lb:'Rapports'}];
  const navMgr=[{id:'dashboard',ic:'📋',lb:'Mon Équipe'},{id:'warroom',ic:'💬',lb:'War Room'},{id:'calendar',ic:'📅',lb:'Agenda'},{id:'ats',ic:'🎯',lb:'Recrutement'}];
  const navEmp=[{id:'portal',ic:'👤',lb:'Mon Portail'},{id:'calendar',ic:'📅',lb:'Agenda'}];
  const nav=role==='admin'?navAdmin:role==='manager'?navMgr:navEmp;
  useEffect(()=>{if(!nav.some(n=>n.id===view))setView(role==='salarie'?'portal':'dashboard')},[role]);

  const viewLabel=nav.find(n=>n.id===view)?.lb||'Dashboard';
  const S={emps,setEmps,addEmp,calEv,setCalEv,addCalEvent,leaves,addLeave,approveLeave,cands,setCands,addCandidate,moveCandidate,vault,saveToVault,addVaultDoc,delVaultDoc,openArt,resolved,resolveAlert,setView,setArt,setModal,role,crmLeads,expenses,addExpense,delExpense,paidIds,togglePaid,isFondateur,myId,chatChannels,chatMessages,sendChat};

  const doSignOut=async()=>{try{await sb.auth.signOut()}catch(e){}setAuthed(false);setCalEv([]);setCands([]);};

  if(authChecking)return(<div style={{minHeight:'100vh',display:'flex',alignItems:'center',justifyContent:'center',color:'var(--t3)'}}>Chargement…</div>);
  if(!authed)return(<AtlasLogin onDone={()=>setAuthed(true)}/>);

  return(<React.Fragment>
    {/* SIDEBAR */}
    <div className="sidebar">
      <div style={{padding:'20px',borderBottom:'1px solid var(--bd)'}}>
        <div style={{display:'flex',alignItems:'center',gap:10,marginBottom:16}}>
          <div style={{width:32,height:32,borderRadius:8,background:'var(--ac)',display:'flex',alignItems:'center',justifyContent:'center',fontSize:15,color:'#fff'}}>⚛</div>
          <div><div style={{fontWeight:700,fontSize:15,color:'var(--t0)'}}>Atlas OS</div><div style={{fontSize:11,color:'var(--t4)'}}>Système RH Intelligent</div></div>
        </div>
        <div className="role-switch">
          {[['admin','Admin DRH'],['manager','Manager'],['salarie','Salarié']].map(([r,lb])=>(
            <button key={r} className={`role-opt ${role===r?'active':''}`} onClick={()=>switchRole(r)}>{lb}</button>
          ))}
        </div>
      </div>
      <div style={{flex:1,overflowY:'auto',display:'flex',flexDirection:'column',padding:'4px 0'}}>
        <div className="nav-section">Navigation</div>
        <div className="nav-list">
        {nav.map(n=>(<div key={n.id} className={`nav-item ${view===n.id?'active':''}`} onClick={()=>setView(n.id)}>
          <span className="nav-icon">{n.ic}</span><span>{n.lb}</span>
          {n.id==='shield'&&crit>0&&<span style={{marginLeft:'auto',background:'var(--er)',color:'#fff',borderRadius:6,padding:'2px 7px',fontSize:10,fontWeight:700}}>{crit}</span>}
        </div>))}
        </div>
      </div>
      <div style={{padding:'16px 20px',borderTop:'1px solid var(--bd)'}}>
        <div style={{display:'flex',alignItems:'center',gap:6,fontSize:12,color:'var(--t3)'}}><span className="status-dot green"></span>Système opérationnel</div>
        <div style={{fontSize:11,color:'var(--t4)',marginTop:4}}>{(crmLeads||[]).length} prospects · {vault.length} documents</div>
      </div>
    </div>

    {/* TOPBAR */}
    <div className="topbar">
      <div className="breadcrumb">Atlas OS <span style={{color:'var(--t4)'}}>/</span> <span>{viewLabel}</span></div>
      <SearchBox leads={crmLeads} cands={cands} vault={vault} events={calEv} go={setView}/>
      <div className="topbar-right">
        <div className="theme-btn" onClick={toggleTheme} title={theme==='dark'?'Mode clair':'Mode sombre'}>{theme==='dark'?'☀️':'🌙'}</div>
        <div className="notif-btn" onClick={()=>setView('dashboard')}>🔔{crit>0&&<div className="notif-dot"></div>}</div>
        <div className="avatar">KM</div>
        <div className="theme-btn" onClick={doSignOut} title="Se déconnecter" style={{fontSize:15}}>⎋</div>
      </div>
    </div>

    {/* MAIN */}
    <div className="main"><div className="main-inner">
      {role==='admin'&&view==='dashboard'&&<DashAdmin S={S}/>}
      {role==='admin'&&view==='warroom'&&<WarRoom S={S}/>}
      {role==='admin'&&view==='finance'&&isFondateur&&<Finance S={S}/>}
      {role==='admin'&&view==='messages'&&<Messagerie S={S}/>}
      {role==='admin'&&view==='crm'&&<CRMHub/>}
      {role==='admin'&&view==='reports'&&<Reports/>}
      {role==='admin'&&view==='coffre'&&<CoffreFort S={S}/>}
      {role==='manager'&&view==='dashboard'&&<DashManager S={S}/>}
      {role==='manager'&&view==='warroom'&&<WarRoom S={S}/>}
      {role==='salarie'&&view==='portal'&&<SalariePortal S={S}/>}
      {view==='calendar'&&<CalendarView S={S}/>}
      {view==='ats'&&<ATSKanban S={S}/>}
    </div></div>

    {art&&<ArtPanel d={art} onClose={()=>setArt(null)} save={saveToVault}/>}
    {modal&&<div className="overlay" onClick={()=>setModal(null)}><div className="modal" onClick={e=>e.stopPropagation()}>{modal}</div></div>}
    {showAP&&<AutoPilot go={()=>{setShowAP(false);LS.s('ap3',true);setView('dashboard');confetti({particleCount:50,spread:50})}}/>}
    <FloatingBot ctx={{leads:crmLeads,cands,calEv,expenses}}/>
  </React.Fragment>);
}

