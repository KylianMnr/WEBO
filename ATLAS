function matchSC(t){const l=t.toLowerCase();
  if(l.includes('conflit')||l.includes('crise')||l.includes('tension')||l.includes('sos'))return{k:'conflit',a:'conflit'};
  if(l.includes('offboard')||l.includes('départ')||l.includes('licenciement')||(l.includes('marc')&&l.includes('gérez')))return{k:'offboarding',a:'offboarding'};
  if(l.includes('embauche')||l.includes('recrut')||l.includes('fiche de poste'))return{k:'embauche',a:'embauche'};
  if(l.includes('réunion')||l.includes('cse')||l.includes('résumé'))return{k:'smartdrop_reunion',a:'smartdrop_reunion'};
  if(l.includes('contrat')||l.includes('draft')||l.includes('vérif'))return{k:'smartdrop_contrat',a:'smartdrop_contrat'};
  if(l.includes('audit')||l.includes('360'))return{k:'audit',a:'audit'};
  return null;
}

