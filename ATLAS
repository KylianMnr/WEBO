/* ═══ FICHE DE POSTE (champ isolé, IA ou saisie manuelle) ═══ */
function JobPostForm({onSave,onClose}){
  const[title,setTitle]=useState('');
  const[content,setContent]=useState('');
  const[busy,setBusy]=useState(false);
  const[err,setErr]=useState('');
  const genAI=async()=>{
    if(!title.trim()){setErr('Renseigne d\'abord l\'intitulé du poste');return;}
    if(!getProxySecret()){setErr('Clé IA manquante : configure-la dans le CRM (elle est partagée).');return;}
    setBusy(true);setErr('');
    try{
      const sys="Tu es un expert RH. Rédige une fiche de poste claire et professionnelle en français pour WEBO, agence spécialisée dans l'accessibilité numérique (mise en conformité EAA et RGAA). Structure : intitulé, contexte de l'entreprise, missions principales, profil recherché, compétences, conditions. N'utilise jamais de tiret cadratin. Format texte simple, pas de markdown lourd.";
      const draft=await aiCall([{role:'user',content:'Rédige une fiche de poste pour : '+title.trim()}],sys);
      setContent(draft);
    }catch(e){setErr('Erreur IA : '+(e.message||'').slice(0,120));}
    setBusy(false);
  };
  const save=()=>{
    if(!title.trim()||!content.trim()){setErr('Intitulé et contenu requis');return;}
    onSave({title:'Fiche de poste — '+title.trim(),content:content.trim()});
  };
  return(<div className="card" style={{padding:16,marginBottom:16}}>
    <div style={{display:'flex',gap:8,marginBottom:8,alignItems:'center',flexWrap:'wrap'}}>
      <input className="input" placeholder="Intitulé du poste (ex : Développeur accessibilité)" value={title} onChange={e=>setTitle(e.target.value)} style={{flex:'1 1 240px'}}/>
      <button className="btn btn-ghost btn-sm" onClick={genAI} disabled={busy}>{busy?'Génération…':'✨ Brouillon IA'}</button>
    </div>
    <textarea placeholder="Contenu de la fiche de poste (généré par l'IA, ou colle la tienne ici)" value={content} onChange={e=>setContent(e.target.value)} style={{width:'100%',minHeight:220,background:'var(--sf1)',border:'1px solid var(--bd)',borderRadius:8,color:'var(--t1)',fontSize:13,fontFamily:'var(--font)',padding:12,lineHeight:1.5,resize:'vertical'}}/>
    {err&&<div style={{fontSize:12,color:'var(--er)',marginTop:8}}>{err}</div>}
    <div style={{display:'flex',gap:8,marginTop:10}}>
      <button className="btn btn-p btn-sm" onClick={save}>Enregistrer au Coffre-Fort</button>
      <button className="btn btn-ghost btn-sm" onClick={onClose}>Fermer</button>
    </div>
  </div>);
}

