/* ═══ DASHBOARD ADMIN ═══ */
function DashAdmin({S}){
  const{crmLeads,cands,calEv,setView}=S;
  const leads=crmLeads||[];
  // Statuts CRM
  const SIGNED=['reussi'];
  const LOST=['perdu','pas_potentiel'];
  const CONTACTED=['contact_std','relance_std','contact_siege','relance_siege','potentiel','rdv_call','relance_rdv'];
  const num=v=>{const n=parseFloat(String(v==null?'':v).replace(/[^0-9.]/g,''));return isNaN(n)?0:n;};
  const signed=leads.filter(l=>SIGNED.includes(l.status));
  const active=leads.filter(l=>!SIGNED.includes(l.status)&&!LOST.includes(l.status));
  const caSigned=signed.reduce((s,l)=>s+num(l.valeur),0);
  const pipeline=active.reduce((s,l)=>s+num(l.valeur),0);
  // Relances en retard (next_relance dans le passé, prospect encore actif)
  const todayStr=todayISO();
  const relDue=leads.filter(l=>{const d=l.next_relance||l.nextRelance;return d&&String(d)<=todayStr&&!SIGNED.includes(l.status)&&!LOST.includes(l.status);});
  // Prospects ajoutés ce mois
  const d=new Date();const ym=d.getFullYear()+'-'+pad2(d.getMonth()+1);
  const newThisMonth=leads.filter(l=>{const c=l.date_created||l.dateCreated;return c&&String(c).slice(0,7)===ym;}).length;
  // Répartition par statut (pour la petite barre)
  const byStatus={};leads.forEach(l=>{byStatus[l.status]=(byStatus[l.status]||0)+1;});
  const STATUS_LBL={site_web:'Formulaire site',identifier:'Identifié',contact_std:'1er Contact',relance_std:'Relance',contact_siege:'Contact Siège',relance_siege:'Relance Siège',potentiel:'Potentiel',pas_potentiel:'Pas de potentiel',rdv_call:'RDV / Call',relance_rdv:'Relance RDV',perdu:'Perdu',reussi:'Signé'};
  const topStatuses=Object.entries(byStatus).sort((a,b)=>b[1]-a[1]).slice(0,6);
  const conv=leads.length?Math.round(signed.length/leads.length*100):0;
  const fmt=n=>n.toLocaleString('fr-FR');

  return(<React.Fragment>
    <div style={{display:'flex',justifyContent:'space-between',alignItems:'flex-start',marginBottom:24,flexWrap:'wrap',gap:12}}>
      <div><h1 className="page-title">Pilotage WEBO</h1><p className="page-sub">{leads.length} prospects · données CRM en temps réel</p></div>
