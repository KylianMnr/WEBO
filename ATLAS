/* ═══ CALENDAR ═══ */
function CalendarView({S}){
  const{calEv,role,addCalEvent}=S;
  const[cur,setCur]=useState(()=>{const t=new Date();return{y:t.getFullYear(),m:t.getMonth()};}); // m = 0..11
  const[showAdd,setShowAdd]=useState(false);
  const[nf,setNf]=useState({title:'',time:'09:00'});
  const[selDay,setSelDay]=useState(null); // jour cliqué (numéro) pour le détail
  const today=new Date();
  const y=cur.y,m=cur.m;
  const first=new Date(y,m,1);
  const daysInMonth=new Date(y,m+1,0).getDate();
  const startOffset=(first.getDay()+6)%7; // Lundi=0
  const MONTHS=['Janvier','Février','Mars','Avril','Mai','Juin','Juillet','Août','Septembre','Octobre','Novembre','Décembre'];
  const evByDay={};
  (calEv||[]).forEach(ev=>{if(!ev.date)return;const[ey,em,ed]=String(ev.date).split('-').map(Number);if(ey===y&&em===m+1)(evByDay[ed]=evByDay[ed]||[]).push(ev);});
  const prevM=()=>{setSelDay(null);setCur(c=>c.m===0?{y:c.y-1,m:11}:{y:c.y,m:c.m-1});};
  const nextM=()=>{setSelDay(null);setCur(c=>c.m===11?{y:c.y+1,m:0}:{y:c.y,m:c.m+1});};
  const isToday=d=>today.getFullYear()===y&&today.getMonth()===m&&today.getDate()===d;
  const typeClass=ev=>{const c=(ev.color||'').toLowerCase();if(c.includes('red')||c.includes('gold'))return'legal';if(c.includes('green'))return'formation';return'meeting';};
  const submitAdd=()=>{if(!nf.title.trim())return;const day=nf._day||(selDay||today.getDate());addCalEvent({date:isoDate(y,m+1,day),title:nf.title,time:nf.time});setShowAdd(false);setNf({title:'',time:'09:00'});};
  const selEvents=selDay?(evByDay[selDay]||[]).slice().sort((a,b)=>String(a.time||'').localeCompare(String(b.time||''))):[];
  return(<React.Fragment>
    <div style={{marginBottom:24,display:'flex',justifyContent:'space-between',alignItems:'flex-end',flexWrap:'wrap',gap:12}}>
      <div><h1 className="page-title">{role==='salarie'?'Mon agenda':'Agenda'}</h1><p className="page-sub">Synchronisé avec le CRM · clique un jour pour le détail</p></div>
      <div style={{display:'flex',gap:8,alignItems:'center'}}>
        <button className="btn btn-ghost btn-sm" onClick={prevM}>←</button>
        <span style={{fontWeight:600,minWidth:140,textAlign:'center'}}>{MONTHS[m]} {y}</span>
        <button className="btn btn-ghost btn-sm" onClick={nextM}>→</button>
        {role!=='salarie'&&<button className="btn btn-p btn-sm" onClick={()=>{setNf({title:'',time:'09:00',_day:selDay||today.getDate()});setShowAdd(true)}}>+ Événement</button>}
      </div>
    </div>
    {showAdd&&<div className="card" style={{padding:16,marginBottom:16,display:'flex',gap:8,flexWrap:'wrap',alignItems:'center'}}>
      <input className="input" placeholder="Titre" value={nf.title} onChange={e=>setNf({...nf,title:e.target.value})} style={{flex:'1 1 200px'}}/>
      <input className="input" type="number" min="1" max={daysInMonth} value={nf._day||today.getDate()} onChange={e=>setNf({...nf,_day:parseInt(e.target.value)||1})} style={{width:70}} title="Jour"/>
      <input className="input" type="time" value={nf.time} onChange={e=>setNf({...nf,time:e.target.value})} style={{width:110}}/>
      <button className="btn btn-p btn-sm" onClick={submitAdd}>Ajouter</button>
      <button className="btn btn-ghost btn-sm" onClick={()=>setShowAdd(false)}>Annuler</button>
    </div>}
    <div className="card" style={{padding:20}}>
      <div className="cal-grid">
        {['Lun','Mar','Mer','Jeu','Ven','Sam','Dim'].map(d=><div key={d} className="cal-head">{d}</div>)}
        {Array.from({length:startOffset},(_,i)=><div key={`e${i}`} className="cal-day empty"></div>)}
        {Array.from({length:daysInMonth},(_,i)=>{const day=i+1;const evts=evByDay[day]||[];const sel=selDay===day;
          return(<div key={day} className={`cal-day ${isToday(day)?'today':''}`} onClick={()=>setSelDay(sel?null:day)} style={{cursor:'pointer',outline:sel?'2px solid var(--ac)':'none'}}>
            <div style={{fontWeight:isToday(day)?600:400,color:isToday(day)?'var(--ac2)':'var(--t3)',marginBottom:2}}>{day}</div>
            {evts.slice(0,3).map((ev,j)=><span key={j} className={`cal-ev ${typeClass(ev)}`} title={ev.time?ev.time+' — '+ev.title:ev.title}>{ev.title}</span>)}
            {evts.length>3&&<span style={{fontSize:10,color:'var(--t4)',display:'block',marginTop:2}}>+{evts.length-3} autre{evts.length-3>1?'s':''}</span>}
          </div>);
        })}
      </div>
    </div>
    {selDay&&<div className="card" style={{padding:20,marginTop:16}}>
      <div style={{display:'flex',justifyContent:'space-between',alignItems:'center',marginBottom:12}}>
        <h3 style={{fontSize:15,fontWeight:600}}>{selDay} {MONTHS[m]} {y}</h3>
        <div style={{display:'flex',gap:8}}>
          {role!=='salarie'&&<button className="btn btn-p btn-sm" onClick={()=>{setNf({title:'',time:'09:00',_day:selDay});setShowAdd(true)}}>+ Ajouter ce jour</button>}
          <button className="btn btn-ghost btn-sm" onClick={()=>setSelDay(null)}>Fermer</button>
        </div>
      </div>
      {selEvents.length===0&&<p style={{color:'var(--t3)',fontSize:13}}>Aucun événement ce jour.</p>}
      {selEvents.map((ev,j)=>(<div key={j} style={{display:'flex',gap:12,alignItems:'flex-start',padding:'10px 0',borderTop:j>0?'1px solid var(--bd)':'none'}}>
        <span style={{fontSize:12,fontWeight:600,color:'var(--t3)',minWidth:44}}>{ev.all_day?'Journée':(ev.time||'—')}</span>
        <div style={{flex:1}}>
          <div style={{fontWeight:500,fontSize:14}}>{ev.title}</div>
          {ev.end_time&&<div style={{fontSize:12,color:'var(--t4)'}}>jusqu'à {ev.end_time}</div>}
        </div>
      </div>))}
    </div>}
  </React.Fragment>);
}

